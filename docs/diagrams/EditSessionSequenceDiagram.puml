@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "e:EditSessionCommand" as EditSessionCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "model:Model" as Model MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant ":UniqueSessionList" as UniqueSessionList MODEL_COLOR
participant ":UniquePersonList" as UniquePersonList MODEL_COLOR
end box

[-> LogicManager : execute("editsession grp/T09 w/3 d/2026-08-27")
activate LogicManager

note over LogicManager
  Parsing creates e as for other
  commands and is omitted here.
end note

LogicManager -> EditSessionCommand : execute(model)
activate EditSessionCommand

EditSessionCommand -> Model : findSession(T09, week 3)
activate Model
Model --> EditSessionCommand : original
deactivate Model

note right of EditSessionCommand
  A CommandException is thrown if there is
  no such session, or if the date is unchanged.
end note

EditSessionCommand -> Model : setSession(original, edited)
activate Model

Model -> AddressBook : setSession(original, edited)
activate AddressBook

loop each student with attendance for original
  AddressBook -> AddressBook : copy the student, replacing the attendance\nwith one for edited and the same status
  activate AddressBook
  deactivate AddressBook
end

AddressBook -> UniqueSessionList : setSession(original, edited)
activate UniqueSessionList
UniqueSessionList --> AddressBook
deactivate UniqueSessionList

AddressBook -> UniquePersonList : setPersons(updated students)
activate UniquePersonList
UniquePersonList --> AddressBook
deactivate UniquePersonList

AddressBook --> Model
deactivate AddressBook
Model --> EditSessionCommand
deactivate Model

EditSessionCommand --> LogicManager : result
deactivate EditSessionCommand

note right of LogicManager
  LogicManager then records the change for
  undo and saves Roster, as for other commands.
end note

[<-- LogicManager : result
deactivate LogicManager
@enduml
