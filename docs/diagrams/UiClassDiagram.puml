@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
title Selected UI classes and their dependencies
package UI <<Rectangle>> {
interface Ui
abstract class UiPart
class UiManager
class MainWindow
class CommandBox
class GroupListPanel
class PersonListPanel
class StudentDetailPanel
}
package Logic <<Rectangle>> {
class FieldCompletion
}
UiManager .up.|> Ui
UiManager --> "1" MainWindow
MainWindow -up-|> UiPart
MainWindow *--> "1" CommandBox
MainWindow *--> "1" GroupListPanel
MainWindow *--> "1" PersonListPanel
MainWindow *--> "1" StudentDetailPanel
CommandBox ..> FieldCompletion
@enduml
