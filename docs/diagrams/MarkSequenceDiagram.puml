@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "m:MarkCommand" as MarkCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "model:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("mark 1 w/5 s/present")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("mark 1 w/5 s/present")
activate AddressBookParser

create MarkCommand
AddressBookParser -> MarkCommand : (index 1, week 5, PRESENT)
activate MarkCommand
MarkCommand --> AddressBookParser
deactivate MarkCommand

AddressBookParser --> LogicManager : m
deactivate AddressBookParser

LogicManager -> MarkCommand : execute(model)
activate MarkCommand

MarkCommand -> Model : getFilteredPersonList()
activate Model
Model --> MarkCommand : displayed students
deactivate Model

MarkCommand -> Model : findSession(student's group, week 5)
activate Model
Model --> MarkCommand : session
deactivate Model

note right of MarkCommand
  If the group has no session for
  week 5, a CommandException is
  thrown and nothing is changed.
end note

MarkCommand -> MarkCommand : create a copy of the student\nwith the new attendance record
activate MarkCommand
deactivate MarkCommand

MarkCommand -> Model : setPerson(student, markedStudent)
activate Model
Model --> MarkCommand
deactivate Model

MarkCommand --> LogicManager : result
deactivate MarkCommand
'Hidden arrow to position the destroy marker below the end of the activation bar.
MarkCommand -[hidden]-> LogicManager
destroy MarkCommand

LogicManager -> Storage : saveAddressBook(...)
activate Storage
Storage --> LogicManager
deactivate Storage

LogicManager -> Model : commitAddressBook("mark")
activate Model
Model --> LogicManager
deactivate Model

[<-- LogicManager : result
deactivate LogicManager
@enduml
