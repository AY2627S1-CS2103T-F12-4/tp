<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" styleClass="roster-content" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="roster-heading">
    <Label fx:id="groupScope" styleClass="roster-title" />
    <Label fx:id="studentCount" styleClass="count-badge" />
    <Region HBox.hgrow="ALWAYS" />
    <Label text="&#10003; Present" styleClass="legend-present" />
    <Label text="&#10007; Absent" styleClass="legend-absent" />
    <Label text="&#8212; Unmarked" styleClass="legend-unmarked" />
  </HBox>
  <HBox fx:id="studentColumns" alignment="CENTER_LEFT" styleClass="table-header">
    <Label text="#" minWidth="30" prefWidth="30" maxWidth="30" />
    <Label text="STUDENT" minWidth="220" prefWidth="220" maxWidth="220" />
    <Label text="GROUP" minWidth="60" prefWidth="60" maxWidth="60" />
    <Label text="ATTENDANCE" />
  </HBox>
  <ListView fx:id="personListView" VBox.vgrow="ALWAYS">
    <placeholder>
      <ScrollPane fx:id="emptyGroupSummary" fitToWidth="true" hbarPolicy="NEVER"
                  minHeight="0" styleClass="empty-group-summary">
        <content>
          <Label fx:id="emptyGroupSessions" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
                 styleClass="empty-group-sessions" />
        </content>
      </ScrollPane>
    </placeholder>
  </ListView>
</VBox>
