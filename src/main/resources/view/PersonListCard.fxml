<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" minHeight="50"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="10" bottom="8" left="10" />
  </padding>
  <Label fx:id="id" minWidth="30" prefWidth="30" maxWidth="30" styleClass="row-index" />
  <VBox alignment="CENTER_LEFT" minWidth="220" prefWidth="220" maxWidth="220" spacing="2">
    <Label fx:id="name" minWidth="0" maxWidth="215" wrapText="true" styleClass="student-name" />
    <Label fx:id="matric" styleClass="student-matric" />
  </VBox>
  <HBox alignment="CENTER_LEFT" minWidth="60" prefWidth="60" maxWidth="60">
    <Label fx:id="group" styleClass="group-badge" />
  </HBox>
  <FlowPane fx:id="attendance" alignment="CENTER_LEFT" hgap="6" vgap="5"
            minWidth="0" minHeight="0" prefWrapLength="120" HBox.hgrow="ALWAYS" />
</HBox>
