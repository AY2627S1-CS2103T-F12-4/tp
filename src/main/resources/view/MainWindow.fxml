<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="Roster" minWidth="740" minHeight="600" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <VBox styleClass="app-shell">
        <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem" mnemonicParsing="false" onAction="#handleHelp" text="Help" />
          </Menu>
        </MenuBar>

        <StackPane fx:id="pageArea" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="main-content">
          <padding>
            <Insets top="14" right="12" bottom="10" left="12" />
          </padding>

          <VBox spacing="2">
            <Label text="Roster" styleClass="page-title" />
            <Label text="Manage students and attendance with commands" styleClass="page-subtitle" />
          </VBox>

          <VBox spacing="8" styleClass="command-section">
            <padding>
              <Insets top="12" right="14" bottom="12" left="14" />
            </padding>
            <Label text="COMMAND" styleClass="section-eyebrow" />
            <StackPane fx:id="commandBoxPlaceholder" />
          </VBox>

          <StackPane fx:id="resultDisplayPlaceholder" minHeight="70" prefHeight="70" maxHeight="110" />

          <VBox fx:id="personList" spacing="8" styleClass="roster-panel" VBox.vgrow="ALWAYS">
            <padding>
              <Insets top="12" right="12" bottom="12" left="12" />
            </padding>
            <StackPane fx:id="groupListPanelPlaceholder" minHeight="56" prefHeight="56" maxHeight="56" />
            <StackPane fx:id="personListPanelPlaceholder" VBox.vgrow="ALWAYS" />
          </VBox>
        </VBox>
          <StackPane fx:id="studentDetailPlaceholder" alignment="CENTER_RIGHT" pickOnBounds="false" />
        </StackPane>

        <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
