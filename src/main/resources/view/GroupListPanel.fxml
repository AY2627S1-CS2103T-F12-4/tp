<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="10" styleClass="group-strip"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label text="Tutorial groups" styleClass="group-strip-label" />
  <ListView fx:id="groupListView" orientation="HORIZONTAL" HBox.hgrow="ALWAYS"
            accessibleText="Tutorial groups"
            accessibleHelp="Use Left/Right or Up/Down to choose a group, then Enter to open it." />
</HBox>
